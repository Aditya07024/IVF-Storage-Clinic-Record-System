# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Layer 1 Site Access Key Hash (SHA-256 hash of access key, default: 'clinic2026')
# Hash generated for 'clinic2026': 04f509e59546059d044f56f0c4369e5d48259461dfb679116e01a88b56d3a089
APP_ACCESS_KEY_HASH=ec189984c5b36432f04401eb55b916a4801153d10b627bc4cc590382e27d1aa8

# Database
DATABASE_URL=postgresql://ivf_user:ivf_password_secure_2026@localhost:5432/ivf_db?schema=public

# Authentication & Security
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_2026
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# OCR & AI Configuration
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-credentials.json
GEMINI_API_KEY=your_gemini_api_key_here

# Permanent Object Storage (Cloudflare R2 / S3 / Local fallback)
STORAGE_PROVIDER=local
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=ivf-patient-records
STORAGE_LOCAL_DIR=./uploads

# Redis Queue
REDIS_HOST=localhost
REDIS_PORT=6379
