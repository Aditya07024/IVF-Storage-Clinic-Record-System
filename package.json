{
  "name": "ivf-embryo-storage-system",
  "version": "1.0.0",
  "private": true,
  "description": "IVF Embryo Storage & Patient Record Management System",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm --prefix apps/backend run dev",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "build:backend": "npm --prefix apps/backend run build",
    "build:frontend": "npm --prefix apps/frontend run build",
    "test": "npm --prefix apps/backend test",
    "prisma:generate": "npm --prefix apps/backend run prisma:generate",
    "prisma:push": "npm --prefix apps/backend run prisma:push",
    "seed": "npm --prefix apps/backend run seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
